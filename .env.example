# Cole aqui sua API Key da TMDB (v3 auth), sem aspas
TMDB_API_KEY=sua_chave_aqui

# Porta em que o backend vai rodar
PORT=3001

# URL do seu front-end (para liberar o CORS). Em desenvolvimento local,
# geralmente é http://localhost:5500 ou similar (depende de como você abre o index.html).
FRONTEND_ORIGIN=http://localhost:5500
